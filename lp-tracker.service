[Unit]
Description=LP Tracker Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=khal
WorkingDirectory=/home/khal/LP_Tracker
# Show print() logs in journalctl right away instead of in buffered bursts
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/khal/LP_Tracker/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
