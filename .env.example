# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Riot Games API Key
# Get from: https://developer.riotgames.com/
# Note: Development keys expire every 24 hours; personal API keys don't
RIOT_API_KEY=your_riot_api_key_here

# Update interval in seconds (default: 3600 = 1 hour)
UPDATE_INTERVAL=3600

# Match notification check interval in seconds (default: 300 = 5 minutes)
NOTIFICATION_INTERVAL=300

# Timezone for displaying timestamps (default: UTC)
# Examples: Europe/Warsaw, America/New_York, Asia/Tokyo
TIMEZONE=UTC

# Team Google Sheet sync (optional, disabled when GOOGLE_SHEET_ID is empty)
# Roster is read from the "Skład" tab, stats are written to the "SoloQ" tab every SHEET_SYNC_INTERVAL seconds.
# Share the sheet with the service account's e-mail as Editor.
GOOGLE_SHEET_ID=
# Service account key; keep it outside the repo (default: ~/.config/lp-tracker/service_account.json)
# GOOGLE_APPLICATION_CREDENTIALS=/home/pi/.config/lp-tracker/service_account.json
# Discord server ID and name of the leaderboard that mirrors the roster
SHEET_GUILD_ID=
SHEET_LEADERBOARD=
SHEET_SYNC_INTERVAL=3600

# Match reminders from the sheet's "Mecze" tab (need the sheet settings above)
# Channel for reminders; empty = the team leaderboard's notification channel
REMINDER_CHANNEL_ID=
# Role to ping in reminders; empty = no ping
REMINDER_ROLE_ID=
REMINDER_CHECK_INTERVAL=300

# Pings about the "Dostępność" tab: Main players with an empty cell for one of the next days
AVAILABILITY_HOUR=12
AVAILABILITY_DAYS=3

# Comments on SoloQ games (streaks, int games...) written by a cheap LLM through OpenRouter.
# Without a key the bot uses template comments.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
ROASTS_ENABLED=1
# Max comments per player per day
ROASTS_PER_DAY=3
# Replying to the bot's message under a SoloQ game starts a conversation (needs the key; off with ROASTS_ENABLED=0).
# Max replies of the bot per person per day
CHAT_REPLIES_PER_DAY=30

# Opponent scouting (/scout): default period of ranked and tournament-code games, in months (/scout offers 3, 6, 12)
SCOUT_MONTHS=6
# Model for the draft plan in scouting reports (rare, so a stronger one) and its thinking effort
SCOUT_MODEL=anthropic/claude-sonnet-5.5
SCOUT_REASONING=medium
# Scouting reports as HTML pages: a folder a web server serves and its public URL (empty = off).
# Use an unguessable folder name; the pages are marked noindex.
SCOUTING_WEB_DIR=
SCOUTING_WEB_URL=
